{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "somboh-edu",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // next/image resizing through Cloudflare Images.
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Branch previews (`wrangler preview`, used by Workers Builds for
  // non-production branches) need their own bindings, mirroring the above.
  "previews": {
    "images": {
      "binding": "IMAGES"
    }
  }
}
